# Local development example. Replace placeholders in your ignored .env file.
APP_NAME=Restaurant App Backend
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_db
DB_USER=postgres
DB_PASSWORD=change_me
DATABASE_TIMEOUT_SECONDS=5

# Alternatively, DATABASE_URL takes precedence over DB_*.
# DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/restaurant_db

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
