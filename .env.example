# Local development example. Replace placeholders in your ignored .env file.
APP_NAME=Restaurant App Backend
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_db
DB_USER=postgres
DB_PASSWORD=change_me
DATABASE_TIMEOUT_SECONDS=5

# Alternatively, DATABASE_URL takes precedence over DB_*.
# DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/restaurant_db

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Replace both placeholders in the ignored .env file. Never commit real secrets.
JWT_SECRET=change_me_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_ISSUER=restaurant-app-backend
JWT_AUDIENCE=restaurant-app
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PHONE_VERIFICATION_TOKEN_EXPIRE_MINUTES=10

OTP_PEPPER=change_me_with_at_least_32_random_characters
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DEBUG_EXPOSE_CODE=false
